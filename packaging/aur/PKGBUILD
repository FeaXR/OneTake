# Generated by scripts/package-manifests.mjs in https://github.com/FeaXR/OneTake

pkgname=one-take-bin
pkgver=1.8.0
pkgrel=1
pkgdesc='Record or open one long WAV and cut it into faded, peak-normalized MP3 files'
arch=('x86_64')
url='https://github.com/FeaXR/OneTake'
license=('MIT')
depends=('alsa-lib' 'at-spi2-core' 'gtk3' 'libnotify' 'libsecret' 'libxss' 'libxtst' 'nss' 'util-linux-libs' 'xdg-utils')
provides=('one-take')
conflicts=('one-take')
options=('!strip' '!debug')
source=("https://github.com/FeaXR/OneTake/releases/download/v${pkgver}/one-take_${pkgver}_amd64.deb"
        "LICENSE-${pkgver}::https://raw.githubusercontent.com/FeaXR/OneTake/v${pkgver}/LICENSE")
noextract=("one-take_${pkgver}_amd64.deb")
sha256sums=('f1430968fb6a2649cb85ae49c53e931f634cf456b71197c38ba5097272dd303b'
            'f2e01fba0507f06c5fc782d7a1d1ffea0de965e9a47b655431b2baa29f6b9885')

package() {
  bsdtar -xOf "one-take_${pkgver}_amd64.deb" 'data.tar.*' | bsdtar -xf - -C "$pkgdir"
  rm -rf "$pkgdir/usr/share/doc"
  # Electron's sandbox helper, set up as the .deb does on systems without user namespaces.
  chmod 4755 "$pkgdir/opt/One Take/chrome-sandbox"
  install -dm755 "$pkgdir/usr/bin"
  ln -s '/opt/One Take/one-take' "$pkgdir/usr/bin/one-take"
  # Tells the app that updates come from the package manager.
  printf AUR > "$pkgdir/opt/One Take/resources/package-manager"
  install -Dm644 "LICENSE-${pkgver}" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
