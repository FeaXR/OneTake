{
  "name": "studio-audio-editor",
  "productName": "Studio Audio Editor",
  "version": "0.1.0",
  "description": "Cut one long WAV into several faded, peak-normalized MP3 files.",
  "author": "FeaXR",
  "license": "MIT",
  "homepage": "https://github.com/FeaXR/Studio-Audio-Editor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FeaXR/Studio-Audio-Editor.git"
  },
  "bugs": {
    "url": "https://github.com/FeaXR/Studio-Audio-Editor/issues"
  },
  "private": true,
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-main.mjs && vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "icon": "electron scripts/make-icon.cjs",
    "test": "node --test \"src/**/*.test.ts\"",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.studioaudioeditor.app",
    "productName": "Studio Audio Editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Studio-Audio-Editor-Setup-${version}.${ext}",
      "oneClick": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "Studio-Audio-Editor-${version}-portable.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "maintainer": "FeaXR",
      "synopsis": "Cut one long WAV into several faded, peak-normalized MP3 files",
      "mimeTypes": [
        "audio/wav",
        "audio/x-wav"
      ],
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "appImage": {
      "artifactName": "Studio-Audio-Editor-${version}-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "studio-audio-editor_${version}_${arch}.${ext}"
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.28.2": true
  }
}
