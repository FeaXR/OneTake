{
  "name": "one-take",
  "productName": "One Take",
  "desktopName": "one-take.desktop",
  "version": "1.1.2",
  "description": "Record or open one long WAV and cut it into faded, peak-normalized MP3 files.",
  "author": "FeaXR",
  "license": "MIT",
  "homepage": "https://github.com/FeaXR/OneTake",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FeaXR/OneTake.git"
  },
  "bugs": {
    "url": "https://github.com/FeaXR/OneTake/issues"
  },
  "private": true,
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-main.mjs && vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "icon": "electron scripts/make-icon.cjs",
    "test": "node --test \"src/**/*.test.ts\"",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.onetake.app",
    "productName": "One Take",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "One-Take-Setup-${version}.${ext}",
      "oneClick": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "One-Take-${version}-portable.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "One Take records from your audio interface.",
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "WAV audio",
            "CFBundleTypeExtensions": [
              "wav"
            ],
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Alternate"
          }
        ]
      }
    },
    "dmg": {
      "artifactName": "One-Take-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icons",
      "extraResources": [
        {
          "from": "build/icons/256x256.png",
          "to": "icon.png"
        }
      ],
      "category": "AudioVideo",
      "maintainer": "FeaXR",
      "synopsis": "Cut one long WAV into several faded, peak-normalized MP3 files",
      "mimeTypes": [
        "audio/wav",
        "audio/x-wav"
      ],
      "target": [
        "AppImage",
        "deb"
      ],
      "syncDesktopName": true
    },
    "appImage": {
      "artifactName": "One-Take-${version}-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "one-take_${version}_${arch}.${ext}"
    },
    "afterPack": "scripts/after-pack.cjs",
    "publish": [
      {
        "provider": "github",
        "owner": "FeaXR",
        "repo": "OneTake"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.28.2": true
  }
}
