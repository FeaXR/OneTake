{
  "version": "1.9.0",
  "description": "Record or open one long WAV and cut it into faded, peak-normalized MP3 files.",
  "homepage": "https://github.com/FeaXR/OneTake",
  "license": "MIT",
  "notes": "Settings and sessions are kept in %APPDATA%\\One Take and Documents\\One Take, so they survive updates and uninstalling.",
  "architecture": {
    "64bit": {
      "url": "https://github.com/FeaXR/OneTake/releases/download/v1.9.0/One-Take-Setup-1.9.0.exe#/dl.7z",
      "hash": "a622b4556c5e13b2c9f96667455ad923cc0c708c0e560877a1c63e67dd3117e8"
    }
  },
  "installer": {
    "script": [
      "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
      "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\`$R0\", \"$dir\\uninstallerIcon.ico\" -Recurse -Force -ErrorAction SilentlyContinue",
      "Set-Content \"$dir\\resources\\package-manager\" 'Scoop' -NoNewline"
    ]
  },
  "shortcuts": [
    [
      "One Take.exe",
      "One Take"
    ]
  ],
  "checkver": {
    "github": "https://github.com/FeaXR/OneTake"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/FeaXR/OneTake/releases/download/v$version/One-Take-Setup-$version.exe#/dl.7z"
      }
    }
  }
}
